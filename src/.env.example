# General Configuration
APP_NAME=monitoring
APP_DEBUG=true

# Available APP_ENV => (stg or stage) | (dev or development) | (prod or production)
APP_ENV=development

# Log Level (available => panic , fatal , error , warn , info , debug , trace )
LOG_LEVEL=info

# gRPC
GRPC_ADDRESS=0.0.0.0:50051

# http
HTTP_ADDRESS="127.0.0.1:8005"

# Database (only postgres)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=monitoring_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_TIMEZONE="UTC"
DB_QUERY_LOG=false

# Kafka
KAFKA_ADDRESS=kafka:9092
PRODUCE_TO_KAFKA="false"
KAFKA_GROUP_ID="monitoring-consumer"

## TOPIC
KAFKA_TOPIC_PUBLISH_MONITORING="MONITORING_TOPIC"
